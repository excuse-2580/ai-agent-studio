{
  "name": "ai-agent-studio",
  "version": "1.0.0",
  "private": true,
  "description": "AI Agent Studio — 自由创建 / 删除 / 设定 AI 智能体的本地工作台，支持本地 .gguf 模型与任意大模型 API，界面遵循 Material Design 3",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "gguf": "node server/gguf-cli.js",
    "sync:android": "cap sync android",
    "open:android": "cap open android",
    "build:android": "cap sync android && cd android && ./gradlew assembleDebug",
    "icons": "python3 tools/gen-icons.py && python3 tools/gen-android-icons.py"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "gguf",
    "llama.cpp",
    "material-design-3"
  ],
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/android": "^6.2.2"
  }
}